# Databricks Workspace & Authentication Configuration
# Copy this file to .env and fill in your real credentials.
# NEVER commit the actual .env file or real secrets to Git.

# Required for online validation
DATABRICKS_HOST=https://<your-workspace>.azuredatabricks.net
DATABRICKS_TOKEN=<your-databricks-token>

# Optional defaults for online validation
DATABRICKS_JOB_ID=
DATABRICKS_CLUSTER_ID=
DATABRICKS_RUN_ID=

# DPIF Application Settings
DPIF_ENVIRONMENT=development
DPIF_DEBUG=false
